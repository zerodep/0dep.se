{
  "name": "zerodep-web",
  "version": "1.14.3",
  "private": true,
  "type": "module",
  "description": "Landing page for the zerodep org and the bpmn-engine ecosystem (zerodep.se / 0dep.se).",
  "scripts": {
    "build": "node src/build.js",
    "pretest": "npm run toc",
    "test": "unnecessary node --experimental-default-config-file test/*.test.js",
    "posttest": "npm run lint && npm run test:md",
    "test:md": "texample",
    "lint": "eslint . --cache && prettier . --check --cache",
    "serve": "node src/serve.js",
    "mcp": "node src/mcp-server.js",
    "toc": "toc -c README.md",
    "posttoc": "prettier --write README.md"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "author": "Pål Edman",
  "devDependencies": {
    "@0dep/bpmn-extensions": "^1.0.0",
    "@0dep/piso": "^6.0.0",
    "@0dep/toc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "amqp-emulator": "^0.1.0",
    "bpmn-elements": "^18.1.0",
    "bpmn-engine": "^26.0.5",
    "bpmn-js": "^18.24.0",
    "bpmn-moddle": "^10.1.0",
    "camunda-bpmn-moddle": "^8.0.1",
    "croner": "^11.0.0",
    "dmn-elements": "^0.4.0",
    "dmn-moddle": "^12.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.1",
    "moddle-context-serializer": "^7.0.0",
    "ocrgenerator": "^3.0.3",
    "prettier": "^3.10.1",
    "texample": "^2.0.0",
    "unnecessary": "^3.3.0",
    "zeebe-bpmn-moddle": "^2.0.0"
  },
  "unnecessary": {
    "filePattern": "\\.js$",
    "excludeDirs": [
      "dist",
      "coverage"
    ],
    "excludeFiles": [
      "eslint.config.js",
      "src/build.js",
      "test/global-setup.js"
    ]
  }
}
